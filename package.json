{
  "name": "my-coding-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "myh": "bun packages/cli/src/main.ts",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
		"test:headless": "bun scripts/test-headless.ts",
		"check:deps": "bun scripts/check-deps.ts",
    "check": "bun run check:deps && bun run typecheck && bun test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "fast-check": "4.3.0",
    "typescript": "5.9.2"
  }
}
